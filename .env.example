# Local development defaults. scripts/dev.sh sets these automatically.
DATABASE_URL=postgres://apex:apex@127.0.0.1:5433/apex?sslmode=disable
LOCAL_DEMO_MODE=true
APP_ENV=development
API_ADDR=:8080
WEB_ORIGIN=http://127.0.0.1:3000
# Optional: binary used by the "Share" dialog / scripts/share.sh.
# SHARE_TARGET=http://127.0.0.1:3000
# CLOUDFLARED_BIN=cloudflared
MEDIA_DIR=./media
COOKIE_SECURE=false

# Production must set:
# LOCAL_DEMO_MODE=false
# APP_ENV=production
# COOKIE_SECURE=true
